generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  ADMIN
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Rooms {
  id            Int    @id @default(autoincrement())
  label         String  @unique
  description   String
  tarif         Float
  category      String
  visit_url     String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model User {
  id            Int    @id @default(autoincrement())
  name          String
  email         String
  password      String
  sexe          String
  phone         String
  role          Role  @default(CLIENT)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}
